{
  "name": "openldr",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "build:check": "turbo build:check",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs",
    "openldr": "node packages/cli/dev.mjs",
    "cert": "sh deploy/letsencrypt.sh",
    "build:plugins": "node scripts/build-wasm-plugins.mjs",
    "build:test-sink": "node scripts/build-test-sink.mjs",
    "build:ui-reference": "pnpm build:test-sink && node scripts/build-ui-reference.mjs",
    "build:dhis2-sink": "node scripts/build-dhis2-sink.mjs",
    "make:whonet-sample": "node scripts/make-whonet-sample.mjs",
    "make:docs-marketplace-bundle": "tsx scripts/make-docs-marketplace-bundle.ts",
    "make:changelog": "tsx scripts/make-changelog.ts",
    "e2e": "turbo build --filter=@openldr/studio --filter=@openldr/server && pnpm --filter @openldr/e2e e2e",
    "verify:ui": "turbo build --filter=@openldr/studio --filter=@openldr/server && pnpm --filter @openldr/e2e capture",
    "docs:screenshots": "turbo build --filter=@openldr/studio --filter=@openldr/server && pnpm --filter @openldr/e2e docs:screenshots",
    "e2e:install-browsers": "node scripts/install-playwright-browsers.mjs",
    "e2e:seed": "pnpm make:whonet-sample && pnpm build:plugins && pnpm openldr db reset && pnpm openldr plugin install reference-plugins/whonet-sqlite/plugin.wasm && pnpm openldr ingest samples/whonet-sample.sqlite --plugin whonet-sqlite",
    "docs:seed": "pnpm make:whonet-sample && pnpm build:plugins && pnpm build:test-sink && pnpm make:docs-marketplace-bundle && pnpm openldr db reset && pnpm openldr plugin install reference-plugins/whonet-sqlite/plugin.wasm && pnpm openldr plugin install reference-plugins/test-sink/plugin.wasm && pnpm openldr ingest samples/whonet-sample.sqlite --plugin whonet-sqlite",
    "dhis2:seed": "node scripts/dhis2-seed.mjs",
    "seed:dhis2-connector": "tsx scripts/seed-dhis2-demo-connector.ts",
    "seed:dhis2-mapping": "tsx scripts/seed-dhis2-demo-mapping.ts",
    "make:lab-sample": "node scripts/make-lab-sample.mjs",
    "load:measure": "node scripts/load-measure.mjs",
    "projection:accept": "tsx scripts/projection-live-acceptance.ts",
    "validation:accept": "tsx scripts/validation-strictness-live-acceptance.ts",
    "mssql:accept": "tsx scripts/mssql-live-acceptance.ts",
    "mssql:accept:matrix": "bash scripts/mssql-matrix-accept.sh",
    "mysql:accept": "tsx scripts/mysql-live-acceptance.ts",
    "reports:accept": "tsx scripts/reports-golden-accept.ts",
    "sync:accept": "tsx scripts/sync-live-acceptance.ts",
    "sync:pull:accept": "tsx scripts/sync-pull-live-acceptance.ts",
    "sync:amend:accept": "tsx scripts/sync-amend-live-acceptance.ts",
    "sync:order-status:accept": "tsx scripts/sync-order-status-live-acceptance.ts",
    "sync:patient-merge:accept": "tsx scripts/sync-patient-merge-live-acceptance.ts",
    "sync:quarantine:accept": "tsx scripts/sync-quarantine-live-acceptance.ts",
    "sync:divergence:accept": "tsx scripts/sync-divergence-live-acceptance.ts",
    "sync:drain:accept": "tsx scripts/sync-drain-live-acceptance.ts",
    "sync:terminology:accept": "tsx scripts/sync-terminology-live-acceptance.ts",
    "sync:gzip:accept": "tsx scripts/sync-gzip-live-acceptance.ts",
    "sync:enroll:accept": "tsx scripts/sync-enroll-live-acceptance.ts",
    "sync:bundle:accept": "tsx scripts/sync-bundle-live-acceptance.ts",
    "sync:e2e": "tsx scripts/sync-two-instance-harness.ts",
    "workflow:secret:accept": "tsx scripts/workflow-secret-smoke.ts",
    "mysql:accept:matrix": "bash scripts/mysql-matrix-accept.sh",
    "make:marketplace-bundle": "tsx scripts/make-marketplace-bundle.ts",
    "marketplace:accept": "tsx scripts/marketplace-live-acceptance.ts",
    "init": "node scripts/init.mjs",
    "publish:images": "bash scripts/build-and-push.sh"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.4.0",
    "esbuild": "^0.24.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-populate": "^1.21.0"
  }
}
