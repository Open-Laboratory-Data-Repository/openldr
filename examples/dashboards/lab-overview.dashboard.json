{
  "name": "Example: lab overview",
  "refreshIntervalSec": 0,
  "filters": [
    {
      "id": "period",
      "label": "Period",
      "type": "date-range",
      "defaultRange": null
    },
    {
      "id": "test",
      "label": "Test",
      "type": "text",
      "optionsSql": "SELECT DISTINCT panel_desc FROM lab_requests WHERE panel_desc IS NOT NULL ORDER BY panel_desc"
    },
    {
      "id": "priority",
      "label": "Priority",
      "type": "text",
      "options": [
        "routine",
        "urgent",
        "asap",
        "stat"
      ]
    }
  ],
  "layout": [
    {
      "i": "s1",
      "x": 0,
      "y": 0,
      "w": 3,
      "h": 2
    },
    {
      "i": "s2",
      "x": 3,
      "y": 0,
      "w": 3,
      "h": 2
    },
    {
      "i": "s3",
      "x": 6,
      "y": 0,
      "w": 3,
      "h": 2
    },
    {
      "i": "s4",
      "x": 9,
      "y": 0,
      "w": 3,
      "h": 2
    },
    {
      "i": "s5",
      "x": 0,
      "y": 2,
      "w": 6,
      "h": 4
    },
    {
      "i": "s6",
      "x": 6,
      "y": 2,
      "w": 6,
      "h": 4
    },
    {
      "i": "s7",
      "x": 0,
      "y": 6,
      "w": 4,
      "h": 4
    },
    {
      "i": "s8",
      "x": 4,
      "y": 6,
      "w": 4,
      "h": 4
    },
    {
      "i": "s9",
      "x": 8,
      "y": 6,
      "w": 4,
      "h": 4
    },
    {
      "i": "s10",
      "x": 0,
      "y": 10,
      "w": 3,
      "h": 4
    },
    {
      "i": "s11",
      "x": 3,
      "y": 10,
      "w": 5,
      "h": 4
    },
    {
      "i": "s12",
      "x": 8,
      "y": 10,
      "w": 4,
      "h": 4
    },
    {
      "i": "s13",
      "x": 0,
      "y": 14,
      "w": 12,
      "h": 4
    }
  ],
  "widgets": [
    {
      "id": "s1",
      "type": "kpi",
      "title": "Total Orders",
      "refreshIntervalSec": 60,
      "visual": {
        "yAxisKey": "value"
      },
      "query": {
        "mode": "builder",
        "model": "service_requests",
        "metric": {
          "key": "count",
          "label": "Orders",
          "agg": "count"
        },
        "filters": [],
        "variableBindings": {
          "authored_on": "period",
          "code_text": "test",
          "priority": "priority"
        }
      }
    },
    {
      "id": "s2",
      "type": "kpi",
      "title": "Distinct Patients",
      "refreshIntervalSec": 60,
      "visual": {
        "yAxisKey": "value"
      },
      "query": {
        "mode": "builder",
        "model": "service_requests",
        "metric": {
          "key": "distinct_subjects",
          "label": "Patients",
          "agg": "count_distinct",
          "column": "patient_id"
        },
        "filters": [],
        "variableBindings": {
          "authored_on": "period",
          "code_text": "test",
          "priority": "priority"
        }
      }
    },
    {
      "id": "s3",
      "type": "kpi",
      "title": "Results Recorded",
      "refreshIntervalSec": 60,
      "visual": {
        "yAxisKey": "value"
      },
      "query": {
        "mode": "builder",
        "model": "observations",
        "metric": {
          "key": "count",
          "label": "Results",
          "agg": "count"
        },
        "filters": [
          {
            "dimension": "status",
            "op": "neq",
            "value": "cancelled"
          }
        ],
        "adhocDimensions": [
          {
            "key": "request_test",
            "label": "Test",
            "join": "jr",
            "column": "panel_desc",
            "kind": "string"
          }
        ],
        "variableBindings": {
          "effective_date_time": "period",
          "request_test": "test"
        }
      }
    },
    {
      "id": "s4",
      "type": "gauge",
      "title": "Result Finalisation %",
      "refreshIntervalSec": 300,
      "visual": {
        "yAxisKey": "value",
        "suffix": "%",
        "minValue": 0,
        "maxValue": 100,
        "greenThreshold": 80,
        "amberThreshold": 60
      },
      "query": {
        "mode": "builder",
        "model": "diagnostic_reports",
        "filters": [],
        "metrics": [
          {
            "key": "reports",
            "label": "Reports",
            "agg": "count"
          },
          {
            "key": "done",
            "label": "Final",
            "agg": "count",
            "where": [
              {
                "dimension": "status",
                "op": "in",
                "value": [
                  "final",
                  "amended"
                ]
              }
            ]
          },
          {
            "key": "value",
            "label": "Final %",
            "agg": "count",
            "derived": {
              "numerator": "done",
              "denominator": "reports",
              "scale": 100,
              "decimals": 0
            }
          }
        ]
      }
    },
    {
      "id": "s5",
      "type": "bar-chart",
      "title": "Orders by Test",
      "refreshIntervalSec": 300,
      "visual": {
        "xAxisKey": "label",
        "yAxisKey": "value",
        "color": "#10b981"
      },
      "query": {
        "mode": "builder",
        "model": "service_requests",
        "metric": {
          "key": "count",
          "label": "Orders",
          "agg": "count"
        },
        "dimension": {
          "key": "code_text"
        },
        "filters": [
          {
            "dimension": "code_text",
            "op": "set",
            "value": null
          }
        ],
        "limit": 15,
        "variableBindings": {
          "authored_on": "period",
          "priority": "priority"
        }
      }
    },
    {
      "id": "s6",
      "type": "area-chart",
      "title": "Orders Trend",
      "refreshIntervalSec": 300,
      "visual": {
        "xAxisKey": "label",
        "yAxisKey": "value",
        "color": "#3b82f6"
      },
      "query": {
        "mode": "builder",
        "model": "service_requests",
        "metric": {
          "key": "count",
          "label": "Orders",
          "agg": "count"
        },
        "dimension": {
          "key": "authored_on",
          "grain": "day"
        },
        "filters": [],
        "variableBindings": {
          "authored_on": "period",
          "code_text": "test",
          "priority": "priority"
        }
      }
    },
    {
      "id": "s7",
      "type": "pie-chart",
      "title": "Orders by Status",
      "refreshIntervalSec": 300,
      "visual": {
        "xAxisKey": "label",
        "yAxisKey": "value",
        "innerRadius": 40
      },
      "query": {
        "mode": "builder",
        "model": "service_requests",
        "metric": {
          "key": "count",
          "label": "Orders",
          "agg": "count"
        },
        "dimension": {
          "key": "status"
        },
        "filters": [],
        "variableBindings": {
          "authored_on": "period",
          "code_text": "test",
          "priority": "priority"
        }
      }
    },
    {
      "id": "s8",
      "type": "row-chart",
      "title": "Orders by Priority",
      "refreshIntervalSec": 300,
      "visual": {
        "xAxisKey": "label",
        "yAxisKey": "value",
        "color": "#f59e0b"
      },
      "query": {
        "mode": "builder",
        "model": "service_requests",
        "metric": {
          "key": "count",
          "label": "Orders",
          "agg": "count"
        },
        "dimension": {
          "key": "priority"
        },
        "filters": [
          {
            "dimension": "priority",
            "op": "set",
            "value": null
          }
        ],
        "variableBindings": {
          "authored_on": "period",
          "code_text": "test"
        }
      }
    },
    {
      "id": "s9",
      "type": "funnel",
      "title": "Order → Report Pipeline",
      "refreshIntervalSec": 300,
      "visual": {
        "xAxisKey": "label",
        "yAxisKey": "value"
      },
      "query": {
        "mode": "sql",
        "sql": "SELECT 'Ordered' AS label, COUNT(*) AS value FROM lab_requests\nUNION ALL SELECT 'Specimen Received', COUNT(*) FROM specimens WHERE received_time IS NOT NULL\nUNION ALL SELECT 'Result Recorded', COUNT(*) FROM lab_results WHERE (status IS NULL OR status <> 'cancelled')\nUNION ALL SELECT 'Report Issued', COUNT(*) FROM diagnostic_reports WHERE issued IS NOT NULL"
      }
    },
    {
      "id": "s10",
      "type": "traffic-light",
      "title": "Abnormal Results",
      "refreshIntervalSec": 300,
      "visual": {
        "yAxisKey": "value",
        "greenThreshold": 10,
        "amberThreshold": 50
      },
      "query": {
        "mode": "builder",
        "model": "observations",
        "metric": {
          "key": "count",
          "label": "Abnormal",
          "agg": "count"
        },
        "filters": [
          {
            "dimension": "interpretation_code",
            "op": "in",
            "value": [
              "H",
              "HH",
              "L",
              "LL",
              "A",
              "AA"
            ]
          }
        ],
        "variableBindings": {
          "effective_date_time": "period"
        }
      }
    },
    {
      "id": "s11",
      "type": "line-chart",
      "title": "Results Trend",
      "refreshIntervalSec": 300,
      "visual": {
        "xAxisKey": "label",
        "yAxisKey": "value",
        "color": "#8b5cf6"
      },
      "query": {
        "mode": "builder",
        "model": "observations",
        "metric": {
          "key": "count",
          "label": "Results",
          "agg": "count"
        },
        "dimension": {
          "key": "effective_date_time",
          "grain": "day"
        },
        "filters": [
          {
            "dimension": "status",
            "op": "neq",
            "value": "cancelled"
          }
        ],
        "adhocDimensions": [
          {
            "key": "request_test",
            "label": "Test",
            "join": "jr",
            "column": "panel_desc",
            "kind": "string"
          }
        ],
        "variableBindings": {
          "effective_date_time": "period",
          "request_test": "test"
        }
      }
    },
    {
      "id": "s12",
      "type": "scatter-plot",
      "title": "Analyte Volume vs Avg Value",
      "refreshIntervalSec": 300,
      "visual": {
        "xAxisKey": "x",
        "yAxisKey": "y",
        "sizeKey": "y"
      },
      "query": {
        "mode": "builder",
        "model": "observations",
        "dimension": {
          "key": "code_text"
        },
        "filters": [
          {
            "dimension": "value",
            "op": "set",
            "value": null
          },
          {
            "dimension": "code_text",
            "op": "set",
            "value": null
          }
        ],
        "limit": 30,
        "metrics": [
          {
            "key": "x",
            "label": "Results",
            "agg": "count"
          },
          {
            "key": "s",
            "label": "Sum",
            "agg": "sum",
            "column": "numeric_value"
          },
          {
            "key": "y",
            "label": "Avg value",
            "agg": "count",
            "derived": {
              "numerator": "s",
              "denominator": "x",
              "scale": 1,
              "decimals": 2
            }
          }
        ]
      }
    },
    {
      "id": "s13",
      "type": "table",
      "title": "Recent Orders",
      "refreshIntervalSec": 0,
      "visual": {
        "columns": [
          {
            "key": "order_id",
            "label": "Order"
          },
          {
            "key": "test",
            "label": "Test"
          },
          {
            "key": "status",
            "label": "Status"
          },
          {
            "key": "priority",
            "label": "Priority"
          },
          {
            "key": "authored",
            "label": "Authored"
          }
        ],
        "pageSize": 10
      },
      "query": {
        "mode": "sql",
        "sql": "SELECT request_id AS order_id, panel_desc AS test, status, priority, substring(authored_at,1,10) AS authored\nFROM lab_requests\nWHERE 1=1\n[[AND substring(authored_at,1,10) >= {{period_from}}]]\n[[AND substring(authored_at,1,10) <= {{period_to}}]]\n[[AND panel_desc = {{test}}]]\n[[AND priority = {{priority}}]]\nORDER BY authored_at DESC\nOFFSET 0 ROWS FETCH NEXT 50 ROWS ONLY",
        "variableBindings": {
          "period": "period",
          "test": "test",
          "priority": "priority"
        },
        "variables": {
          "period": {
            "type": "date-range",
            "label": "Period"
          },
          "test": {
            "type": "text",
            "label": "Test"
          },
          "priority": {
            "type": "text",
            "label": "Priority",
            "options": [
              "routine",
              "urgent",
              "asap",
              "stat"
            ]
          }
        }
      }
    }
  ]
}
