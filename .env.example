NODE_ENV=development
PORT=3000
# Bind the Studio dev server to this address instead of localhost, so other devices on the tailnet
# can reach it (read by apps/studio/vite.config.ts). Comment out to go back to localhost-only.
DEV_HOST=127.0.0.1
LOG_LEVEL=info

# local keeps OpenLDR's own accounts and needs no Keycloak. It needs SECRETS_ENCRYPTION_KEY, which
# this file sets in the DHIS2 block below to a development-only value. Without a key the server
# will not start.
# AUTH_ADAPTER also accepts keycloak, or oidc for generic discovery with JWT access tokens.
# Both need the Keycloak and OIDC block below.
AUTH_ADAPTER=local
BLOB_ADAPTER=minio
EVENTING_ADAPTER=pg
TARGET_STORE_ADAPTER=pg

# Dashboard raw SQL is now a Settings → General feature flag (default off), not an env var.

INTERNAL_DATABASE_URL=postgres://openldr:openldr@localhost:5433/openldr
TARGET_DATABASE_URL=postgres://openldr:openldr@localhost:5433/openldr_target

S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=GK6f70656e6c64722d64657621
S3_SECRET_ACCESS_KEY=6465762d6f6e6c792d6761726167652d7365637265742d6b65792d3030303031
S3_BUCKET=openldr
S3_FORCE_PATH_STYLE=true

# --- Keycloak and OIDC: for AUTH_ADAPTER=keycloak and oidc only ---
# Leave every line here commented under local sign-in. An empty `OIDC_ISSUER_URL=` line stops the
# server, because an empty value is not a URL.
# IDENTITY_ADMIN_ADAPTER defaults to keycloak for keycloak auth, none for oidc.
# Set none to disable provider administration. Generic auth rejects keycloak admin.
# IDENTITY_ADMIN_ADAPTER=none
# OIDC_ISSUER_URL=http://localhost:8180/realms/openldr
# OIDC_AUDIENCE=openldr-api
# OIDC_WEB_CLIENT_ID=openldr-web
# Include provider-required API scopes while retaining openid.
# OIDC_SCOPES=openid profile email
# Set the provider's resource URL when required for JWT access tokens.
# OIDC_RESOURCE=https://YOUR_PROVIDER/API_RESOURCE
# Keep the existing issuer on upgrade. Later issuer changes block startup.
# Generic OIDC needs a public authorization-code client with PKCE and no client secret.
# Redirect URI: https://YOUR_HOST/studio/auth/callback
# OIDC_INTERNAL_ISSUER_URL is Keycloak-only. Generic mode ignores it.
# OIDC_INTERNAL_JWKS_URL may explicitly override the signing-key endpoint in either mode.
# Provider setup and issuer restrictions: /docs/auth-providers
# KEYCLOAK_ADMIN_CLIENT_ID=openldr-admin
# KEYCLOAK_ADMIN_CLIENT_SECRET=openldr-admin-dev-secret

# --- Target store engine ---
# pg (default) writes the analytics warehouse to Postgres (TARGET_DATABASE_URL).
# mssql writes it to SQL Server (MSSQL_* below); start it with: docker compose --profile mssql up -d
TARGET_STORE_ADAPTER=pg
# MSSQL_HOST=127.0.0.1
# MSSQL_PORT=11433
# MSSQL_DATABASE=openldr
# MSSQL_USER=sa
# MSSQL_PASSWORD=Openldr_Local_2026!
# MSSQL_ENCRYPT=false
# MSSQL_TRUST_SERVER_CERT=true

# --- DHIS2 reporting target ---
# There is no env var for this any more. A reporting target is a DHIS2 Connector you create
# in the app (Settings > Connectors), and the sink plugin is resolved per connector.
# Start a local DHIS2: pnpm dhis2:seed && docker compose --profile dhis2 up -d
# Connector secrets are encrypted at rest with SECRETS_ENCRYPTION_KEY (base64, 32 bytes,
# generate with: openssl rand -base64 32). Local sign-in also seals its token signing key with it.
# The value below is for development only. It is public, so it protects nothing. The installer
# and `pnpm run init` generate a fresh key for a real install. Never use this one there.
SECRETS_ENCRYPTION_KEY=b3Blbmxkci1kZXYtb25seS1zZWNyZXRzLWtleS0wMDE=

# --- Marketplace ---
# Default remote registry seeded on first boot (when the registry table is empty).
MARKETPLACE_REGISTRY_URL=https://raw.githubusercontent.com/Open-Laboratory-Data-Repository/marketplace/main

# --- CLI commands sent through the app ---
# The server finds the CLI by itself in a checkout and in the image, so neither needs CLI_ENTRY.
# A relative CLI_ENTRY is read from the folder the server runs in. Under `pnpm -C apps/server dev`
# (and `pnpm dev`) that is apps/server, so the CLI in this checkout is ../../packages/cli/dev.mjs.
# An absolute path is safest: it means the same file from any folder.
# CLI_ENTRY=../../packages/cli/dev.mjs
# CLI_MAX_RUNNING=2
# CLI_MAX_UPLOAD_BYTES=2147483648
