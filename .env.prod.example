# Copy to .env.prod and fill in. NEVER commit .env.prod (it is gitignored).
# Service hostnames (postgres / minio / keycloak) refer to docker-compose.prod.yml services.
#
# ⚠️  SECURITY: the credential values below (POSTGRES_PASSWORD, S3_ACCESS_KEY_ID/SECRET,
#     KEYCLOAK_ADMIN_PASSWORD, KEYCLOAK_ADMIN_CLIENT_SECRET) are WEAK DEV DEFAULTS. `pnpm run init`
#     REPLACES every one of them with a generated per-install secret on first run. If you deploy
#     MANUALLY (copying this file), you MUST change all of them — docker-compose.prod.yml has no
#     fallback and refuses to start when a secret env var is unset, but it cannot detect a value you
#     left at the default. Keep INTERNAL_DATABASE_URL / TARGET_DATABASE_URL passwords in sync with
#     POSTGRES_PASSWORD.

# Image tag pulled from GHCR. In THIS file it pins only the keycloak image: api, studio and web
# are built from source here (`build:`), and the gateway is stock nginx. The installer's compose
# file pulls all five images, so there the tag decides the whole stack's version.
OPENLDR_VERSION=latest

# --- Gateway / public addressing (set by `pnpm run init`) ---
# The public hostname/IP the gateway serves. Used for the TLS cert, nginx server_name,
# the OIDC issuer, and Keycloak's advertised hostname.
SERVER_NAME=localhost
PUBLIC_ORIGIN=https://localhost
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
TLS_MODE=self-signed
# LETSENCRYPT_EMAIL=ops@example.org   # required when TLS_MODE=letsencrypt

# Path, inside the API container, to this server's public TLS certificate. When set and readable,
# the Sites page can offer it for download so a remote lab can trust a self-signed central.
# Commented out because docker-compose.prod.yml mounts no cert into the `api` service. To use it,
# add a volume to that service and uncomment this. The `install/` compose file already does both.
#   volumes:
#     - ./deploy/nginx/certs/fullchain.pem:/etc/openldr/tls-cert.pem:ro
# Unset, or set to a path that does not exist, both give the same 404 on that download.
# TLS_CERT_PATH=/etc/openldr/tls-cert.pem

# The other side of the same job: a CENTRAL's certificate, so THIS lab can reach it over TLS.
# Node reads extra trusted CAs from this file. Without it, sync to a self-signed central fails
# with a bare `fetch failed`. Commented out for the same reason as TLS_CERT_PATH, and it needs
# the same treatment: docker-compose.prod.yml mounts nothing here, deploy/install does.
#   volumes:
#     - ./deploy/nginx/certs/central/fullchain.pem:/etc/ssl/central-ca.pem:ro
# Create that host file BEFORE `docker compose up`, even empty. Bind-mounting a path that does
# not exist makes Docker silently create a DIRECTORY there, and the api then fails to start.
# An empty file is fine and means "no extra CAs trusted yet" (verified on node v22 in the api
# image). To trust a central later, overwrite the file and restart the api. No env edit needed.
# NODE_EXTRA_CA_CERTS=/etc/ssl/central-ca.pem

PORT=3000
NODE_ENV=production

# Number of reverse-proxy hops in front of the app. One gateway fronts it, so 1 is correct here.
# Unset means do not trust X-Forwarded-For, and req.ip becomes the gateway's container IP, which
# makes the auth.failed audit useless for tracing a real client. `true` (trust every hop) and a
# comma-separated list of trusted proxy IPs or subnets also work.
# SECURITY: only set this when a trusted proxy really does front the app. Otherwise a client can
# spoof its own IP through the header.
TRUST_PROXY=1

# Internal Postgres (the `postgres` service). The target (analytics warehouse) DB is the
# `openldr_target` database created by scripts/init-target-db.sql in the same instance.
INTERNAL_DATABASE_URL=postgres://openldr:openldr@postgres:5432/openldr
TARGET_DATABASE_URL=postgres://openldr:openldr@postgres:5432/openldr_target
POSTGRES_PASSWORD=openldr

# Blob storage (the `minio` service)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=openldr
S3_FORCE_PATH_STYLE=true
# TERMINOLOGY_WORK_DIR=/var/lib/openldr/terminology-work   # working dir for terminology distribution
#   download + extraction (LOINC/SNOMED zips, 100-500MB). Defaults to the OS temp dir if unset — on
#   a container with a small /tmp this can fill up; set this to a path with ephemeral disk headroom
#   (several GB free) sized for the largest distribution you expect to import.

# --- Auth (Keycloak proxied under /auth on the same origin) ---
# Keycloak runs in production mode (`start`) and stores its data in a `keycloak` database inside the
# SAME internal Postgres (no second Postgres) — it connects as the `openldr` role with POSTGRES_PASSWORD
# above, so there is no separate Keycloak DB credential to set here.
# Public issuer: used by the browser AND for issuer-claim validation.
OIDC_ISSUER_URL=https://localhost/auth/realms/openldr
# Internal (back-channel) JWKS: the app fetches signing keys over the docker network, so it
# needs no trust of the gateway's (possibly self-signed) cert. Issuer claim still validated
# against OIDC_ISSUER_URL above.
OIDC_INTERNAL_JWKS_URL=http://keycloak:8080/auth/realms/openldr/protocol/openid-connect/certs
# Internal (back-channel) realm base — sibling of OIDC_INTERNAL_JWKS_URL above. Server-side
# token/admin REST/JWKS calls use it instead of the public issuer (which, inside a container,
# resolves to the app itself). Issuer claim validation still uses OIDC_ISSUER_URL.
OIDC_INTERNAL_ISSUER_URL=http://keycloak:8080/auth/realms/openldr
OIDC_WEB_CLIENT_ID=openldr-web
# OIDC_AUDIENCE=
# AUTH_DEV_BYPASS=true   # requires NODE_ENV=development (forbidden in production)
# Keycloak's advertised external hostname (hostname v2). Must match PUBLIC_ORIGIN + /auth.
KC_HOSTNAME=https://localhost/auth
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Confidential client (service account) Keycloak uses for identity-admin REST calls (site
# enrollment, user management). Required for those actions to work.
KEYCLOAK_ADMIN_CLIENT_ID=openldr-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=openldr-admin-dev-secret
# Initial password for the seeded `labadmin` (lab_admin) realm user. `pnpm run init` generates this and
# forces a password change on first sign-in. Change it for a manual deploy.
# INITIAL_LAB_ADMIN_PASSWORD=

# Run DB migrations on server startup (idempotent). Keep ON for this single-port
# deployment so a fresh Postgres self-migrates — otherwise the API 500s on a schema-less DB.
MIGRATE_ON_START=true

# Seed idempotent sample data (org/location/patient + bundled sample forms) on startup,
# after migration. ON so the demo comes up populated; set false for an empty production DB.
SEED_ON_START=true

# Adapters / features
TARGET_STORE_ADAPTER=pg

# External analytics target = Microsoft SQL Server (set TARGET_STORE_ADAPTER=mssql).
# Self-hosted only — no cloud/hosted databases. Supported: SQL Server 2017, 2019, 2022.
# MSSQL_HOST=your-sql-server-host
# MSSQL_PORT=1433
# MSSQL_DATABASE=openldr_target
# MSSQL_USER=openldr
# MSSQL_PASSWORD=change-me
# MSSQL_ENCRYPT=false
# MSSQL_TRUST_SERVER_CERT=true

# External analytics target = MySQL/MariaDB (set TARGET_STORE_ADAPTER=mysql).
# Self-hosted only — no cloud/hosted MySQL. Supported: MySQL 8.4 LTS, MariaDB 11.4 LTS.
# MYSQL_HOST=your-mysql-host
# MYSQL_PORT=3306
# MYSQL_DATABASE=openldr_target
# MYSQL_USER=openldr
# MYSQL_PASSWORD=change-me
# MYSQL_SSL=false

# Dashboard raw SQL is now a Settings → General feature flag (default off), not an env var.

# Encrypts connector/DHIS2 secrets at rest (required for those features).
# SECRETS_ENCRYPTION_KEY=  # base64 32 bytes: openssl rand -base64 32

# --- Terminology ---
# Base dir the terminology ingest worker unzips an uploaded distribution into. Each job gets a
# fresh subdir, removed when the job ends. Defaults to the OS temp dir, which in a container is
# often a small RAM-backed /tmp. A full SNOMED CT release needs room for the zip and the
# extracted tree at once, so set this to a real volume if an import fails on disk space.
# TERMINOLOGY_WORK_DIR=/data/terminology-work

# --- Marketplace ---
MARKETPLACE_DEV_ALLOW_UNSIGNED=false
# Default remote registry seeded on first boot (when the registry table is empty).
MARKETPLACE_REGISTRY_URL=https://raw.githubusercontent.com/Open-Laboratory-Data-Repository/marketplace/main
# MARKETPLACE_REGISTRY_DIR=/app/marketplace-registry
LOG_LEVEL=info
